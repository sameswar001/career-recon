# Copy to .env and fill in. Only TAVILY_API_KEY is required.

# Web search for the researcher node (required)
TAVILY_API_KEY=

# LLM provider: ollama (default) | anthropic | openai
# Ollama needs a local server (`ollama serve`) and a pulled model
# (`ollama pull llama3.1`). No API key needed for the default.
LLM_PROVIDER=ollama

# Optional: override the default model for the chosen provider
# LLM_MODEL=llama3.1

# Only needed if LLM_PROVIDER is set to that cloud provider
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
